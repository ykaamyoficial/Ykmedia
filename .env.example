APP_NAME=YkMedia
ENVIRONMENT=development
WEBHOOK_SECRET=troque-por-um-segredo
# Token exigido nas rotas de API do aplicativo. Deixe vazio em desenvolvimento;
# o executavel empacotado gera e persiste um valor automaticamente.
API_AUTH_TOKEN=
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=ykmedia
EVOLUTION_TIMEOUT_SECONDS=10
FILE_STORAGE_ROOT=media
CONVERSATION_SESSION_TTL_SECONDS=3600
CONVERSATION_FLOW_TIMEOUT_SECONDS=1800
SESSION_EXPIRY_WARNING_SECONDS=300
# Worker de fundo que reprocessa jobs que falharam por causas transitorias.
QUEUE_RETRY_WORKER_ENABLED=true
MEDIA_GROUPING_WINDOW_SECONDS=8
YOUTUBE_DOWNLOAD_TEMP_ROOT=downloads/youtube
FFMPEG_PATH=
SQLITE_DATABASE_PATH=data/ykmedia.sqlite3
# Mantido em 0.0.0.0 porque o container Docker da Evolution alcanca o webhook
# via host.docker.internal. As rotas do aplicativo sao protegidas por API_AUTH_TOKEN.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8010
BACKEND_HEALTH_URL=http://localhost:8010/health
BACKEND_MONITOR_INTERVAL_SECONDS=5
BACKEND_STARTUP_TIMEOUT_SECONDS=20
BACKEND_RESTART_ATTEMPTS=3
FRONTEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost
